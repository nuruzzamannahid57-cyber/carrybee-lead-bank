{
  "manifest_version": 3,
  "name": "Carrybee Lead Bank — Auto COD & 2% Incentive Tracker",
  "version": "2.0.0",
  "description": "Zero-config automatic COD & order sync from hive.carrybee.com/orders exclusively for merchants marked Onboarded in Carrybee Lead Bank.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://hive.carrybee.com/*",
    "https://*.carrybee.com/*",
    "https://carrybee-lead-bank-gamma.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Carrybee Auto COD Tracker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://hive.carrybee.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://hive.carrybee.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://carrybee-lead-bank-gamma.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
